# =============================================================================
# Configuracion de la pila en Docker.
#
#   cp .env.docker.example .env
#
# Genera cada secreto con:  openssl rand -base64 48
# Este archivo va al repositorio; el .env que crees a partir de el, NUNCA.
# =============================================================================

NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1
TZ=America/Lima

# Puerto por el que se publica la web en la maquina anfitriona.
WEB_PORT=8080

# --- Base de datos -----------------------------------------------------------
# `db` es el nombre del servicio en docker-compose; no lo cambies.
DB_HOST=db
DB_PORT=3306
DB_NAME=verde_bowl_v3
DB_USER=verdebowl
DB_PASSWORD=CAMBIAME_clave_de_la_aplicacion
DB_ROOT_PASSWORD=CAMBIAME_clave_de_root

# El esquema lo gestiona el servicio `migrate`. Con NODE_ENV=production, el arranque
# se niega a continuar si alguno de estos viene en true.
DB_SYNC=false
DB_ALTER=false
DB_FORCE=false
DB_AUTO_CREATE=false
DB_SEED=true
SEED_DEMO_DATA=false

# --- Red y dominios ----------------------------------------------------------
# Sin barra final. Debe ser el dominio real: la guarda de produccion rechaza localhost.
FRONTEND_URL=https://verdebowl.com
CORS_ORIGIN=https://verdebowl.com

# 1 detras de nginx o del balanceador del proveedor. De esto dependen el rate
# limiting por IP y la IP que queda registrada en la auditoria.
TRUST_PROXY=1

# --- Sesiones ----------------------------------------------------------------
# Minimo 32 caracteres y DISTINTOS entre si; el arranque lo verifica.
JWT_ACCESS_SECRET=CAMBIAME_genera_uno_con_openssl_rand_base64_48
JWT_REFRESH_SECRET=CAMBIAME_genera_OTRO_distinto_del_anterior
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Superadmin inicial ------------------------------------------------------
ADMIN_EMAIL=admin@verdebowl.com
ADMIN_PASSWORD=CAMBIAME_no_puede_ser_la_de_ejemplo

# --- Pagos -------------------------------------------------------------------
# Obligatorias en produccion: sin ellas el sistema usaria el simulador local.
STRIPE_SECRET_KEY=sk_live_
STRIPE_WEBHOOK_SECRET=whsec_
MOCK_WEBHOOK_SECRET=CAMBIAME_aunque_no_se_use_en_produccion

# --- Correo ------------------------------------------------------------------
# Obligatorio en produccion: sin MAIL_HOST los correos se pierden en la consola.
# Verifica SPF, DKIM y DMARC del dominio o los avisos de pedido iran a spam.
MAIL_HOST=smtp.tuproveedor.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=hola@verdebowl.com
MAIL_FROM_NAME=Verde Bowl

# --- Operacion ---------------------------------------------------------------
IGV_RATE=0.18
SLOT_HORIZON_DAYS=14
SLOT_CAPACITY=20
SLOT_WINDOWS=12-14,19-21
SLOT_CUTOFF_HOURS=2

# --- Copias de seguridad -----------------------------------------------------
RETENTION_DAYS=14
BACKUP_DIR=./backups

# --- Geocodificacion (opcional) ----------------------------------------------
GEOAPIFY_API_KEY=
