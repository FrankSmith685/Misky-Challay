# =============================================================================
# Configuracion de la pila en Docker.
#
#   cp .env.docker.example .env.docker
#
# Genera cada secreto con:  openssl rand -base64 48
# Este archivo va al repositorio; el .env.docker que crees a partir de él, NUNCA.
# =============================================================================

NODE_ENV=production
# Vista previa privada: bloquea todas las operaciones de escritura y los pedidos.
PREVIEW_MODE=false
# Activacion excepcional y temporal mientras el Superadmin completa la identidad
# fiscal. Deja RUC y domicilio vacios; nunca presentes valores inventados.
ALLOW_PENDING_BUSINESS_INFO=false
# Sin pasarela online se puede vender con efectivo al recibir, solo delivery y
# hasta el monto configurado. Yape/Plin se configuran desde Superadmin.
COD_ENABLED=false
COD_MAX_AMOUNT=300
PORT=4000
API_PREFIX=/api/v1
TZ=America/Lima

# Puerto por el que se publica la web en la maquina anfitriona.
WEB_PORT=8080

# --- Base de datos -----------------------------------------------------------
# `db` es el nombre del servicio en docker-compose; no lo cambies.
DB_HOST=db
DB_PORT=3306
DB_NAME=DulceFlow
DB_USER=dulceflow
DB_PASSWORD=CAMBIAME_clave_de_la_aplicacion
DB_ROOT_PASSWORD=CAMBIAME_clave_de_root

# El esquema lo gestiona el servicio `migrate`. Con NODE_ENV=production, el arranque
# se niega a continuar si alguno de estos viene en true.
DB_SYNC=false
DB_ALTER=false
DB_FORCE=false
DB_AUTO_CREATE=false
DB_SEED=true
SEED_DEMO_DATA=false

# --- Red y dominios ----------------------------------------------------------
# Sin barra final. Debe ser el dominio real: la guarda de produccion rechaza localhost.
FRONTEND_URL=https://dulceflow.example.com
CORS_ORIGIN=https://dulceflow.example.com

# 1 detras de nginx o del balanceador del proveedor. De esto dependen el rate
# limiting por IP y la IP que queda registrada en la auditoria.
TRUST_PROXY=1

# --- Sesiones ----------------------------------------------------------------
# Minimo 32 caracteres y DISTINTOS entre si; el arranque lo verifica.
JWT_ACCESS_SECRET=CAMBIAME_genera_uno_con_openssl_rand_base64_48
JWT_REFRESH_SECRET=CAMBIAME_genera_OTRO_distinto_del_anterior
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Par persistente para notificaciones push y clave de cifrado del panel.
# Genera cada valor en el servidor; no copies los secretos de desarrollo.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@ejemplo.com
SETTINGS_ENCRYPTION_KEY=

# --- Superadmin inicial ------------------------------------------------------
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=CAMBIAME_no_puede_ser_la_de_ejemplo

# --- Pagos -------------------------------------------------------------------
# Configura una sola pasarela real. Sin token, el pago online queda desactivado;
# la tienda puede operar con contra entrega si COD_ENABLED=true.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_MODE=live
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MOCK_WEBHOOK_SECRET=CAMBIAME_aunque_no_se_use_en_produccion

# --- Correo ------------------------------------------------------------------
# Obligatorio en produccion: sin MAIL_HOST los correos se pierden en la consola.
# Verifica SPF, DKIM y DMARC del dominio o los avisos de pedido iran a spam.
MAIL_HOST=smtp.tuproveedor.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=contacto@ejemplo.com
MAIL_FROM_NAME=Misky Challay

# --- Identidad legal del negocio ---------------------------------------------
# Obligatorio de cara al consumidor en Peru: encabeza el Libro de Reclamaciones,
# las paginas legales y los correos. Rellena con los datos reales de tu empresa.
BUSINESS_LEGAL_NAME=Misky Challay (datos legales pendientes)
BUSINESS_COMMERCIAL_NAME=Misky Challay
BUSINESS_RUC=20600000000
BUSINESS_ADDRESS=Av. Ejemplo 123, Miraflores, Lima
BUSINESS_PHONE=+51 999 999 999
BUSINESS_EMAIL=contacto@ejemplo.com
BUSINESS_SUPPORT_EMAIL=reclamos@ejemplo.com
COMPLAINT_RESPONSE_DAYS=15

# --- Operacion ---------------------------------------------------------------
IGV_RATE=0.18
SLOT_HORIZON_DAYS=14
SLOT_CAPACITY=20
SLOT_WINDOWS=12-14,19-21
SLOT_CUTOFF_HOURS=2

# --- Copias de seguridad -----------------------------------------------------
RETENTION_DAYS=14
BACKUP_DIR=./backups

# --- Geocodificacion (opcional) ----------------------------------------------
GEOAPIFY_API_KEY=
