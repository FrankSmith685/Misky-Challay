# URL base del API. En desarrollo se usa el proxy de Vite (/api -> backend).
VITE_API_URL=/api/v1
VITE_API_PROXY_TARGET=http://127.0.0.1:4000
VITE_APP_NAME=Misky Challay
# En desarrollo los QR usan FRONTEND_URL de backend/.env cuando es HTTPS.
# Opcional: fijar otro origen publico; tiene prioridad y tambien se usa en builds.
# VITE_PUBLIC_WEB_URL=https://tutienda.com
