{
  "name": "@verde-bowl/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cliente web de Verde Bowl (React + TypeScript + Vite + Tailwind + Redux Toolkit)",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:colors && npm run check:permissions && npm run check:admin-nav && npm run check:ar && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\" && npm run check:colors && npm run check:permissions && npm run check:admin-nav",
    "check:admin-nav": "node ../scripts/check-admin-nav.mjs",
    "check:ar": "node ../scripts/check-misky-ar-assets.cjs",
    "check:colors": "node scripts/check-color-ramps.mjs",
    "check:permissions": "node scripts/check-permissions-parity.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^3.10.0",
    "@mui/material": "^9.2.0",
    "@reduxjs/toolkit": "^2.5.0",
    "axios": "^1.7.9",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.469.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-leaflet": "^4.2.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^2.6.0",
    "three": "^0.186.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
