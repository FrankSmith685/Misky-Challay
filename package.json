{
  "name": "verde-bowl-v3",
  "version": "0.1.0",
  "private": true,
  "description": "Verde Bowl - Plataforma de comida saludable: catalogo, constructor de bowls, planes con saldo, cobertura y operacion.",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n BACKEND,FRONTEND -c green.bold,cyan.bold \"npm:dev:backend\" \"npm:dev:frontend:when-ready\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:3d": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-photo3d-local.ps1",
    "dev:local3d": "concurrently -k -n MOTOR3D,WEB \"npm:dev:3d\" \"npm:dev\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:frontend:when-ready": "node scripts/wait-for-backend.mjs && npm run dev:frontend",
    "dev:mobile": "npm run start --prefix mobile",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "typecheck": "npm run typecheck --workspace backend && npm run typecheck --workspace frontend && npm run typecheck --prefix mobile",
    "lint": "npm run lint --workspace backend && npm run lint --workspace frontend",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md}\"",
    "db:seed": "npm run db:seed --workspace backend",
    "check:admin-nav": "node scripts/check-admin-nav.mjs",
    "clean": "rimraf backend/dist frontend/dist node_modules/.cache"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "concurrently": "^9.1.2",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1"
  },
  "overrides": {
    "sequelize": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
