{
  "name": "@verde-bowl/backend",
  "version": "0.1.0",
  "private": true,
  "description": "API modular de Verde Bowl (Node + TypeScript + Express + Sequelize + MySQL)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.json && tsc-alias -p tsconfig.json && node scripts/copy-migrations.cjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "db:seed": "tsx src/database/seeders/index.ts",
    "db:migrate": "tsx src/database/migrate.ts up",
    "db:migrate:status": "tsx src/database/migrate.ts pending",
    "db:migrate:applied": "tsx src/database/migrate.ts executed",
    "db:migrate:undo": "tsx src/database/migrate.ts down",
    "db:migrate:create": "tsx src/database/migrate.ts create --skip-verify",
    "db:baseline": "node scripts/dump-baseline.cjs",
    "db:rebuild": "node scripts/rebuild-schema.cjs",
    "db:check-drift": "tsx scripts/check-schema-drift.ts",
    "test": "tsx --test \"src/tests/**/*.test.ts\"",
    "verify:builder-data": "node scripts/verify-builder-data.cjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "mysql2": "^3.12.0",
    "nodemailer": "^9.0.3",
    "sequelize": "^6.37.5",
    "stripe": "^22.3.1",
    "umzug": "^3.8.3",
    "uuid": "^11.0.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^8.57.1",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
