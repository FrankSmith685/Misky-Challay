# Copia este archivo en Render desde Environment > Add from .env.
# Sustituye todos los valores REPLACE_WITH_* antes de desplegar.

NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=https://REPLACE_WITH_FRONTEND_DOMAIN
TZ=America/Lima
TRUST_PROXY=1

IGV_RATE=0.18

BUSINESS_LEGAL_NAME=REPLACE_WITH_LEGAL_NAME
BUSINESS_COMMERCIAL_NAME=Misky Challay
BUSINESS_RUC=REPLACE_WITH_RUC
BUSINESS_ADDRESS=REPLACE_WITH_LEGAL_ADDRESS
BUSINESS_PHONE=REPLACE_WITH_BUSINESS_PHONE
BUSINESS_EMAIL=REPLACE_WITH_BUSINESS_EMAIL
BUSINESS_SUPPORT_EMAIL=REPLACE_WITH_SUPPORT_EMAIL
COMPLAINT_RESPONSE_DAYS=15

SLOT_HORIZON_DAYS=14
SLOT_CAPACITY=20
SLOT_WINDOWS=12-14,19-21
SLOT_CUTOFF_HOURS=2

DB_HOST=REPLACE_WITH_AIVEN_HOST
DB_PORT=26997
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=REPLACE_WITH_NEW_AIVEN_PASSWORD
DB_SSL=true
DB_SSL_CA=
DB_LOGGING=false
DB_AUTO_CREATE=false
DB_SYNC=false
DB_ALTER=false
DB_FORCE=false
DB_SEED=true
SEED_DEMO_DATA=false

JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_SECRET_32_CHARS_MINIMUM
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_32_CHARS_MINIMUM
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

ADMIN_EMAIL=REPLACE_WITH_ADMIN_EMAIL
ADMIN_PASSWORD=REPLACE_WITH_STRONG_ADMIN_PASSWORD

FRONTEND_URL=https://REPLACE_WITH_FRONTEND_DOMAIN
MOBILE_RETURN_BASE_URL=

# Usa una sola pasarela. Estos valores son para Mercado Pago en producción.
MERCADOPAGO_ACCESS_TOKEN=APP_USR-REPLACE_WITH_LIVE_ACCESS_TOKEN
MERCADOPAGO_WEBHOOK_SECRET=REPLACE_WITH_MERCADO_PAGO_WEBHOOK_SECRET
MERCADOPAGO_MODE=live
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MOCK_WEBHOOK_SECRET=REPLACE_WITH_RANDOM_WEBHOOK_SECRET

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_TEMPLATE_LANGUAGE=es
WHATSAPP_TEMPLATE_ORDER_CONFIRMED=
WHATSAPP_TEMPLATE_ORDER_READY=
WHATSAPP_TEMPLATE_ORDER_OUT_FOR_DELIVERY=
WHATSAPP_TEMPLATE_DESIGN_QUOTED=

MOBILE_MIN_SUPPORTED_VERSION=0.0.0
MOBILE_LATEST_VERSION=0.0.0
MOBILE_UPDATE_URL=
MOBILE_UPDATE_URL_ANDROID=
MOBILE_UPDATE_URL_IOS=
MOBILE_MAINTENANCE=false
MOBILE_MAINTENANCE_MESSAGE=

VAPID_PUBLIC_KEY=REPLACE_WITH_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=REPLACE_WITH_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:REPLACE_WITH_OPERATIONS_EMAIL

GEOAPIFY_API_KEY=
GEOAPIFY_BASE_URL=https://api.geoapify.com/v1/geocode
PHOTON_BASE_URL=https://photon.komoot.io
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
ROUTING_BASE_URL=

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CAKE_PREVIEW_MAX_PER_HOUR=12
CAKE_3D_PROVIDER=disabled
MESHY_API_KEY=
HUNYUAN_3D_URL=
HUNYUAN_3D_API_KEY=
TRIPOSR_3D_URL=http://127.0.0.1:8091
TRIPOSR_3D_RESOLUTION=192
TRIPOSR_3D_TEXTURE_RESOLUTION=1024
SF3D_3D_URL=http://127.0.0.1:8091
SF3D_3D_TEXTURE_RESOLUTION=1024
HUNYUAN_MINI_3D_URL=http://127.0.0.1:8091
HUNYUAN_MINI_3D_RESOLUTION=192
HUNYUAN_MINI_3D_TEXTURE_RESOLUTION=1024
HUNYUAN_MINI_3D_STEPS=8
CAKE_3D_MAX_ACTIVE=2
CAKE_3D_HOURLY_LIMIT=6

MAIL_HOST=REPLACE_WITH_SMTP_HOST
MAIL_PORT=587
MAIL_USER=REPLACE_WITH_SMTP_USER
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM=REPLACE_WITH_MAIL_FROM
MAIL_FROM_NAME=Misky Challay
SETTINGS_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_ENCRYPTION_KEY_32_CHARS_MINIMUM
