# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Zona horaria de la operacion. Los contenedores arrancan en UTC y sin esto los
# horarios de sucursal y las franjas de entrega se desplazan 5 horas.
TZ=America/Lima

# Saltos de proxy de confianza para leer la IP real del cliente (X-Forwarded-For).
# 0 en local; 1 detras de nginx, Cloud Run, Railway o similar. De esto dependen el
# rate limiting por IP y la IP que queda registrada en audit_logs.
TRUST_PROXY=0

# NOTA: con NODE_ENV=production el arranque exige configuracion real y falla si
# detecta DB_SYNC/DB_ALTER/SEED_DEMO_DATA activos, credenciales de ejemplo,
# secretos JWT cortos o CORS/FRONTEND_URL apuntando a localhost.

# ---------------------------------------------------------------------------
# IGV
# El precio del catalogo YA lo incluye (obligatorio de cara al consumidor en Peru).
# Esta tasa solo sirve para desglosarlo en el pedido y en el comprobante; cambiarla
# no altera lo que paga el cliente. Cada pedido guarda la tasa con la que se cerro.
# ---------------------------------------------------------------------------
IGV_RATE=0.18

# ---------------------------------------------------------------------------
# Identidad legal del negocio
# Datos del proveedor que la ley peruana obliga a mostrar al consumidor y que
# encabezan el Libro de Reclamaciones y los correos. Son marcadores: rellenalos
# con los datos reales de tu empresa antes de vender.
# ---------------------------------------------------------------------------
BUSINESS_LEGAL_NAME=Misky Challay (datos legales pendientes)
BUSINESS_COMMERCIAL_NAME=Misky Challay
BUSINESS_RUC=20600000000
BUSINESS_ADDRESS=Av. Ejemplo 123, Miraflores, Lima
BUSINESS_PHONE=+51 999 999 999
BUSINESS_EMAIL=contacto@ejemplo.com
BUSINESS_SUPPORT_EMAIL=reclamos@ejemplo.com
# Dias habiles para responder un reclamo del Libro (INDECOPI).
COMPLAINT_RESPONSE_DAYS=15

# ---------------------------------------------------------------------------
# Franjas de entrega programada
# Un job las regenera cada 6 horas manteniendo el horizonte, para que la entrega
# programada no desaparezca de la web al agotarse los dias ya creados.
# ---------------------------------------------------------------------------
SLOT_HORIZON_DAYS=14
SLOT_CAPACITY=20
# Ventanas en horas locales, "inicio-fin" separadas por coma.
SLOT_WINDOWS=12-14,19-21
# Horas de antelacion con las que se cierran los pedidos de una franja.
SLOT_CUTOFF_HOURS=2

# ---------------------------------------------------------------------------
# Base de datos MySQL
# La base se crea sola al iniciar el servidor si no existe (DB_AUTO_CREATE=true)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=DulceFlow
DB_USER=root
DB_PASSWORD=
# TLS: obligatorio con bases gestionadas (Aiven, TiDB Cloud...). El certificado del
# servidor se verifica siempre. DB_SSL_CA es el CA en PEM (Aiven lo da en la consola);
# en un panel de una sola linea, escribe los saltos de linea como \n.
DB_SSL=false
DB_SSL_CA=
DB_LOGGING=false
DB_AUTO_CREATE=true

# ---------------------------------------------------------------------------
# Sincronizacion de modelos (ver tambien src/index.ts -> DATABASE_STARTUP)
#   DB_SYNC=true   -> sincroniza los modelos al arrancar
#   DB_ALTER=true  -> ajusta las tablas existentes sin borrar datos
#   DB_FORCE=true  -> DROP + CREATE de todas las tablas (BORRA TODO)
#   DB_SEED=true   -> ejecuta los seeders base despues de sincronizar
#   Las opciones basicas de alergenos y etiquetas se aseguran aun con DB_SEED=false.
# ---------------------------------------------------------------------------
DB_SYNC=true
DB_ALTER=true
DB_FORCE=false
DB_SEED=true
# true: agrega catálogo, planes, cupones, sucursal, inventario y repartidores.
# Usa false en producción para cargar solamente los datos maestros esenciales.
SEED_DEMO_DATA=true

# ---------------------------------------------------------------------------
# Seguridad / JWT
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=cambia-esta-clave-en-produccion
JWT_REFRESH_SECRET=cambia-esta-clave-refresh-en-produccion
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ---------------------------------------------------------------------------
# Usuario administrador inicial (creado por el seeder)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=Admin123*

# ---------------------------------------------------------------------------
# Pagos (Mercado Pago en Peru; Stripe solo para entidades admitidas)
# Sin una pasarela configurada se usa el simulador local de desarrollo, sin cobrar.
# En produccion es obligatorio configurar un proveedor y su webhook firmado.
# Configura solo uno: MERCADOPAGO_* o STRIPE_*.
# Mercado Pago: crea una aplicacion Checkout Pro, copia su Access Token y el
# secreto de Webhooks, y suscribe el evento Order (Mercado Pago).
# Tanto el Access Token de prueba como el productivo empiezan con APP_USR-.
# Declara MERCADOPAGO_MODE=test o live segun la seccion de donde lo copiaste.
# Guia: docs/MERCADOPAGO.md
#
# Para probar con Stripe en local:
#   1) STRIPE_SECRET_KEY=sk_test_...
#   2) stripe listen --forward-to localhost:4000/api/v1/payments/webhooks/stripe
#   3) pega el whsec_... que imprime en STRIPE_WEBHOOK_SECRET
#
# No hace falta VITE_STRIPE_PUBLIC_KEY: esta app usa Stripe Checkout alojado y
# los datos de la tarjeta nunca pasan por el frontend.
# TEST:  sk_test_... + el whsec_... temporal de `stripe listen`
# LIVE:  sk_live_... + el whsec_... del endpoint HTTPS creado en Stripe
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# WhatsApp Business Platform (opcional). Sin estos datos no se envían mensajes.
# Configura plantillas aprobadas con 2 variables de cuerpo: {{1}} número de
# pedido/solicitud y {{2}} enlace completo a su detalle.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=
WHATSAPP_TEMPLATE_LANGUAGE=es
WHATSAPP_TEMPLATE_ORDER_CONFIRMED=
WHATSAPP_TEMPLATE_ORDER_READY=
WHATSAPP_TEMPLATE_ORDER_OUT_FOR_DELIVERY=
WHATSAPP_TEMPLATE_DESIGN_QUOTED=
# En pruebas físicas usa el origen LAN del frontend, por ejemplo http://192.168.1.50:5173.
# En producción usa el dominio HTTPS público. Nunca recibe una URL enviada por el cliente.
MOBILE_RETURN_BASE_URL=

# --- App movil: compuerta de version y mantenimiento -------------------------
# Son los mandos que dejan sacar de circulacion una version rota o cortar el
# servicio sin publicar nada en las tiendas. Vacias = nadie queda bloqueado y el
# mantenimiento esta apagado. La app las consulta en GET /settings/public al
# arrancar y al volver del segundo plano; si la peticion falla, no bloquea.
MOBILE_MIN_SUPPORTED_VERSION=0.0.0   # por debajo de esta version la app se bloquea
MOBILE_LATEST_VERSION=0.0.0          # aviso suave de 'hay algo nuevo'
MOBILE_UPDATE_URL=                   # enlace generico si no hay uno por tienda
MOBILE_UPDATE_URL_ANDROID=           # define el enlace de Play Store cuando publiques la app
MOBILE_UPDATE_URL_IOS=               # ponlo tras la primera publicacion en App Store
MOBILE_MAINTENANCE=false
MOBILE_MAINTENANCE_MESSAGE=

# Alertas push del KDS. Genera un par una sola vez con:
# npx web-push generate-vapid-keys
# Conserva la privada solo en el servidor.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:operaciones@ejemplo.com

# Direcciones y mapas. Geoapify es el proveedor recomendado para producción.
# Sin clave, Photon cubre el autocompletado de desarrollo. Nominatim se usa solo
# al confirmar una dirección o mover el pin; no se usa como autocomplete.
GEOAPIFY_API_KEY=
GEOAPIFY_BASE_URL=https://api.geoapify.com/v1/geocode
PHOTON_BASE_URL=https://photon.komoot.io
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Endpoint compatible con OSRM. Vacio = estimacion local por zona.
ROUTING_BASE_URL=

# Generacion opcional de imagenes con FLUX.1 Schnell en Cloudflare Workers AI.
# Crea un token de Workers AI y copia el Account ID desde el panel de Cloudflare.
# Sin ambos valores, el generador aparece como no configurado; las otras formas
# de subir imagenes siguen funcionando. Guarda el token solo en backend/.env.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Vista automática del configurador: máximo de solicitudes por IP y hora.
CAKE_PREVIEW_MAX_PER_HOUR=12
# Foto de torta -> modelo 3D real. disabled | meshy | hunyuan | triposr | sf3d | hunyuanmini.
# Meshy necesita una clave propia; Hunyuan necesita su API en un servidor con GPU.
CAKE_3D_PROVIDER=disabled
MESHY_API_KEY=
HUNYUAN_3D_URL=
HUNYUAN_3D_API_KEY=
TRIPOSR_3D_URL=http://127.0.0.1:8091
TRIPOSR_3D_RESOLUTION=192
TRIPOSR_3D_TEXTURE_RESOLUTION=1024
# Stable Fast 3D: acceso HF aceptado y scripts/setup-photo3d-sf3d.ps1.
# El token se conserva con hf auth login en la cache privada local.
SF3D_3D_URL=http://127.0.0.1:8091
SF3D_3D_TEXTURE_RESOLUTION=1024
# Hunyuan Mini local: forma con IA; colores del frente de la foto, reverso estimado.
HUNYUAN_MINI_3D_URL=http://127.0.0.1:8091
HUNYUAN_MINI_3D_RESOLUTION=192
HUNYUAN_MINI_3D_TEXTURE_RESOLUTION=1024
HUNYUAN_MINI_3D_STEPS=8
CAKE_3D_MAX_ACTIVE=2
# Generaciones nuevas por IP/hora; reanudar no consume cupo. 0 desactiva el cupo.
CAKE_3D_HOURLY_LIMIT=6
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_MODE=
MOCK_WEBHOOK_SECRET=dev-mock-webhook-secret

# ---------------------------------------------------------------------------
# Email
# Sin MAIL_HOST los correos se imprimen en la consola (util en desarrollo).
# Cualquier proveedor sirve: Gmail, SendGrid, Resend, Mailgun... todos hablan SMTP.
# ---------------------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=contacto@ejemplo.com
MAIL_FROM_NAME=Misky Challay
# Secreto aleatorio de 32+ caracteres. No se muestra en la web ni debe subirse a Git.
# Cifra la contrasena SMTP que el superadmin guarda desde el panel.
SETTINGS_ENCRYPTION_KEY=cambia-por-un-secreto-aleatorio-de-32-caracteres
