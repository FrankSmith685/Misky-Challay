# ---------------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Zona horaria de la operacion. Los contenedores arrancan en UTC y sin esto los
# horarios de sucursal y las franjas de entrega se desplazan 5 horas.
TZ=America/Lima

# Saltos de proxy de confianza para leer la IP real del cliente (X-Forwarded-For).
# 0 en local; 1 detras de nginx, Cloud Run, Railway o similar. De esto dependen el
# rate limiting por IP y la IP que queda registrada en audit_logs.
TRUST_PROXY=0

# NOTA: con NODE_ENV=production el arranque exige configuracion real y falla si
# detecta DB_SYNC/DB_ALTER/SEED_DEMO_DATA activos, credenciales de ejemplo,
# secretos JWT cortos o CORS/FRONTEND_URL apuntando a localhost.

# ---------------------------------------------------------------------------
# Base de datos MySQL
# La base se crea sola al iniciar el servidor si no existe (DB_AUTO_CREATE=true)
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=verde_bowl_v3
DB_USER=root
DB_PASSWORD=
DB_LOGGING=false
DB_AUTO_CREATE=true

# ---------------------------------------------------------------------------
# Sincronizacion de modelos (ver tambien src/index.ts -> DATABASE_STARTUP)
#   DB_SYNC=true   -> sincroniza los modelos al arrancar
#   DB_ALTER=true  -> ajusta las tablas existentes sin borrar datos
#   DB_FORCE=true  -> DROP + CREATE de todas las tablas (BORRA TODO)
#   DB_SEED=true   -> ejecuta los seeders base despues de sincronizar
# ---------------------------------------------------------------------------
DB_SYNC=true
DB_ALTER=true
DB_FORCE=false
DB_SEED=true
# true: agrega catálogo, planes, cupones, sucursal, inventario y repartidores.
# Usa false en producción para cargar solamente los datos maestros esenciales.
SEED_DEMO_DATA=true

# ---------------------------------------------------------------------------
# Seguridad / JWT
# ---------------------------------------------------------------------------
JWT_ACCESS_SECRET=cambia-esta-clave-en-produccion
JWT_REFRESH_SECRET=cambia-esta-clave-refresh-en-produccion
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10

# ---------------------------------------------------------------------------
# Usuario administrador inicial (creado por el seeder)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@verdebowl.com
ADMIN_PASSWORD=Admin123*

# ---------------------------------------------------------------------------
# Pagos (Stripe)
# Sin STRIPE_SECRET_KEY se usa el simulador local: mismo ciclo y mismo webhook
# firmado, pero sin cobrar. En produccion la clave es obligatoria.
#
# Para probar con Stripe en local:
#   1) STRIPE_SECRET_KEY=sk_test_...
#   2) stripe listen --forward-to localhost:4000/api/v1/payments/webhooks/stripe
#   3) pega el whsec_... que imprime en STRIPE_WEBHOOK_SECRET
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# Direcciones y mapas. La clave de Geoapify activa autocompletado real.
# Sin clave, la app ofrece una direccion contextual y permite ubicarla manualmente
# en el mapa; la busqueda explicita usa Nominatim respetando su limite publico.
GEOAPIFY_API_KEY=
GEOAPIFY_BASE_URL=https://api.geoapify.com/v1/geocode
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Endpoint compatible con OSRM. Vacio = estimacion local por zona.
ROUTING_BASE_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MOCK_WEBHOOK_SECRET=dev-mock-webhook-secret

# ---------------------------------------------------------------------------
# Email
# Sin MAIL_HOST los correos se imprimen en la consola (util en desarrollo).
# Cualquier proveedor sirve: Gmail, SendGrid, Resend, Mailgun... todos hablan SMTP.
# ---------------------------------------------------------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=hola@verdebowl.com
MAIL_FROM_NAME=Verde Bowl
