{
  "expo": {
    "name": "Misky Challay",
    "slug": "frank-smith",
    "scheme": "verdebowl",
    "version": "0.9.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/bd694d85-89e8-4e4d-bd68-a041d1bcbd26"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.verdebowl.app"
    },
    "android": {
      "package": "com.verdebowl.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#FFFAF4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Misky Challay necesita la cámara para leer el QR de tu mesa."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0b5fa8",
          "defaultChannel": "order-updates"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Misky Challay usa tu ubicación mientras eliges una dirección para comprobar la cobertura y ubicar el punto de entrega."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFAF4",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#FFFAF4"
          }
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-font",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "bd694d85-89e8-4e4d-bd68-a041d1bcbd26"
      }
    },
    "owner": "frankporx12s-team"
  }
}
