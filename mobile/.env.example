# En un celular físico NO uses localhost. Reemplaza esta IP por la IPv4 de tu PC.
EXPO_PUBLIC_API_URL=http://192.168.1.50:4000/api/v1
# Origen de la web o CDN que sirve las imágenes del catálogo.
EXPO_PUBLIC_WEB_URL=http://192.168.1.50:5173
# Identificador asignado por `npx eas-cli init`; requerido para push remoto.
EXPO_PUBLIC_EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
